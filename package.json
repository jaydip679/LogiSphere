{
  "name": "logisphere",
  "version": "1.0.0",
  "private": true,
  "description": "LogiSphere — B2B2C logistics and supply chain management platform",
  "workspaces": [
    "services/*",
    "frontend/*",
    "shared/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e-test.js",
    "db:migrate": "node scripts/migrate-all.js",
    "seed:admin": "node services/auth-service/scripts/seedAdmin.js",
    "generate:keys": "node scripts/generate-jwt-keys.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
