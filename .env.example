# ==============================================================================
# LogiSphere — Root Environment Variables & Configuration Checklist
# ==============================================================================
# This template documents all environment variables used by Docker Compose and
# local service development. Copy this file to .env before starting services:
#   cp .env.example .env
#
# NOTE: .env is git-ignored and must never contain real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE SETTINGS (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Mandatory for all microservices. When using Docker Compose, the database
# host is "postgres"; for local host execution, use "localhost".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Note: If POSTGRES_PASSWORD contains special characters (like '@', '#', '$'),
# specify POSTGRES_PASSWORD_ENCODED (e.g. 'my%40pass') for URL connection strings.
POSTGRES_PASSWORD_ENCODED=postgres
POSTGRES_DB=logisphere
POSTGRES_PORT=5432

# Root connection string (defaults to auth schema if not specified)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=auth"

# Dedicated Per-Service Database Schema URLs (used by Prisma migrations)
DATABASE_URL_AUTH="postgresql://postgres:postgres@localhost:5432/logisphere?schema=auth"
DATABASE_URL_SHIPMENT="postgresql://postgres:postgres@localhost:5432/logisphere?schema=shipment"
DATABASE_URL_FLEET="postgresql://postgres:postgres@localhost:5432/logisphere?schema=fleet"
DATABASE_URL_TRACKING="postgresql://postgres:postgres@localhost:5432/logisphere?schema=tracking"
DATABASE_URL_NOTIFICATION="postgresql://postgres:postgres@localhost:5432/logisphere?schema=notification"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Asymmetric RSA-256 JWT)
# ------------------------------------------------------------------------------
# Mandatory: Internal service-to-service communication shared secret
INTERNAL_SERVICE_KEY="logisphere_secret_key_2026"

# JWT token expiration intervals
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# RSA Key Paths (Relative to repository root or service root)
# Private key: Auth Service only (never commit or bake into images)
JWT_PRIVATE_KEY_PATH="services/auth-service/secrets/jwt-private.key"

# Public key: API Gateway, Shipment, Fleet, Tracking, Notification services
JWT_PUBLIC_KEY_PATH="shared/keys/jwt-public.key"

# Initial Platform Administrator Bootstrap Credentials
# (Used by db-migrate container or npm run seed:admin)
ADMIN_EMAIL="admin@logisphere.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"
ADMIN_FULL_NAME="Platform Administrator"

# ------------------------------------------------------------------------------
# 3. AWS / LOCALSTACK SQS CONFIGURATION (Event-Driven Messaging)
# ------------------------------------------------------------------------------
# In local development and Docker Compose, LocalStack emulates AWS SQS.
# Dummy credentials ('test') are used and valid for LocalStack.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Endpoint:
#   - For host-based local scripts/services: http://localhost:4566
#   - For Docker Compose internal network:   http://localstack:4566
SQS_ENDPOINT="http://localhost:4566"

# Dedicated SQS Queue URLs
FLEET_QUEUE_URL="http://localhost:4566/000000000000/logisphere-fleet-queue"
TRACKING_QUEUE_URL="http://localhost:4566/000000000000/logisphere-tracking-queue"
NOTIFICATION_QUEUE_URL="http://localhost:4566/000000000000/logisphere-notification-queue"
NOTIFICATION_DLQ_URL="http://localhost:4566/000000000000/logisphere-notification-dlq"

# ------------------------------------------------------------------------------
# 4. MICROSERVICE NETWORKING & PORTS
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
SHIPMENT_SERVICE_PORT=5002
FLEET_SERVICE_PORT=5003
TRACKING_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005
WEB_APP_PORT=3000

# Inter-Service URLs (Host / Local development defaults)
AUTH_SERVICE_URL="http://localhost:5001"
SHIPMENT_SERVICE_URL="http://localhost:5002"
FLEET_SERVICE_URL="http://localhost:5003"
TRACKING_SERVICE_URL="http://localhost:5004"
NOTIFICATION_SERVICE_URL="http://localhost:5005"

# ------------------------------------------------------------------------------
# 5. OPTIONAL CONFIGURATIONS
# ------------------------------------------------------------------------------
# Notification Service Email Provider:
# Provider selection: 'auto' (default: uses Gmail if OAuth creds present, else SMTP, else mock), 'gmail', 'smtp', or 'mock'
EMAIL_PROVIDER="auto"
EMAIL_FROM="LogiSphere Notifications <notifications@logisphere.local>"

# Option A: Gmail REST API with OAuth 2.0 (Recommended, HTTPS Port 443)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""

# Option B: Standard SMTP (Optional fallback)
# If left empty and no Gmail credentials are configured, falls back safely to console/structured logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LogiSphere Notifications <notifications@logisphere.local>"

# Shipment Service Temporary Reports Directory
TEMP_REPORT_DIR="services/shipment-service/temp_reports"
REPORT_TTL_MINUTES=5
