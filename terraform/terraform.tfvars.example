# ==============================================================================
# LogiSphere — Example Configuration Variables Template
# Copy this file to 'terraform.tfvars' to customize default values.
# ==============================================================================

# Target AWS Region
aws_region = "ap-south-1"

# Environment & Resource Naming
environment  = "production"
project_name = "logisphere"
cluster_name = "logisphere-eks-cluster"

# Kubernetes Version in Standard Support (EKS v1.36)
kubernetes_version = "1.36"

# Restrict public Kubernetes API access
# CRITICAL SECURITY NOTE: Never leave this set to ["0.0.0.0/0"] in production.
# Replace the documentation CIDR below with your actual workstation public IP address in CIDR format
# (e.g. ["198.51.100.42/32"]) in your private 'terraform.tfvars' file.
# You can find your current public IP by running: curl -s https://checkip.amazonaws.com
cluster_endpoint_public_access_cidrs = ["203.0.113.50/32"] # REPLACE WITH YOUR WORKSTATION PUBLIC IP /32

# SQS Queue Prefix for EKS Workloads (enforces isolation from localstack and demo queues)
sqs_queue_prefix = "logisphere-eks-"

# Networking & Cost Optimization
# Set single_nat_gateway = true to provision 1 shared NAT Gateway (~$32/mo savings)
enable_nat_gateway = true
single_nat_gateway = true

# EKS Worker Node Sizing & Capacity
# Use "SPOT" for on-demand demo sessions (~70% discount) or "ON_DEMAND"
node_capacity_type = "SPOT"
node_instance_types = ["t3.small"]

# Node Group Scaling
node_scaling_config = {
  desired_size = 2
  min_size     = 1
  max_size     = 3
}

node_disk_size_gb = 20

# Common Resource Tags
tags = {
  Project     = "LogiSphere"
  Environment = "production"
  ManagedBy   = "Terraform"
  CostCenter  = "Demonstration"
}
