NODE_ENV=development
PORT=5005
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=notification"

# Shared RSA Public Key for JWT Verification
JWT_PUBLIC_KEY_PATH="../../shared/keys/jwt-public.key"

# Internal Service Secret for inter-service communication
INTERNAL_SERVICE_KEY="dev_internal_secret_key"

# AWS / LocalStack SQS Configuration
AWS_REGION="ap-south-1"
SQS_ENDPOINT="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
NOTIFICATION_QUEUE_URL="http://localhost:4566/000000000000/logisphere-notification-queue"
NOTIFICATION_DLQ_URL="http://localhost:4566/000000000000/logisphere-notification-dlq"

# Email Provider Settings ('auto', 'gmail', 'smtp', or 'mock')
EMAIL_PROVIDER="auto"
EMAIL_FROM="LogiSphere Notifications <notifications@logisphere.local>"

# Gmail REST API with OAuth 2.0 (HTTPS Port 443)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""

# SMTP Configuration (optional fallback: falls back to dev logger if absent)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LogiSphere Notifications <notifications@logisphere.local>"
