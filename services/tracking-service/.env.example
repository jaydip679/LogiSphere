NODE_ENV=development
PORT=5004
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=tracking"

# Shared RSA Public Key for JWT Verification
JWT_PUBLIC_KEY_PATH="../../shared/keys/jwt-public.key"

# Internal Service Secret for inter-service communication
INTERNAL_SERVICE_KEY="dev_internal_secret_key"

# AWS / LocalStack SQS Configuration
AWS_REGION="ap-south-1"
SQS_ENDPOINT="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
TRACKING_QUEUE_URL="http://localhost:4566/000000000000/logisphere-tracking-queue"
