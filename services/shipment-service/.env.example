NODE_ENV=development
PORT=5002
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=shipment"

# Shared RSA Public Key for JWT Verification
JWT_PUBLIC_KEY_PATH="../../shared/keys/jwt-public.key"

# Internal Microservices
AUTH_SERVICE_URL="http://localhost:5001"
FLEET_SERVICE_URL="http://localhost:5003"
INTERNAL_SERVICE_KEY="dev_internal_secret_key"

# AWS / LocalStack SQS Configuration
AWS_REGION="ap-south-1"
SQS_ENDPOINT="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Temporary Reports Storage
REPORTS_DIR="storage/reports"
REPORT_TTL_MINUTES=5
