NODE_ENV=development
PORT=5001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=app_auth"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/logisphere?schema=app_auth"

# RSA Key Paths
JWT_PRIVATE_KEY_PATH="secrets/jwt-private.key"
JWT_PUBLIC_KEY_PATH="../../shared/keys/jwt-public.key"

# Token TTL
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Internal Service Secret for inter-service communication
INTERNAL_SERVICE_KEY="dev_internal_secret_key"

# Initial Platform Admin Bootstrap (used only by npm run seed:admin)
ADMIN_EMAIL="admin@logisphere.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"
ADMIN_FULL_NAME="Platform Administrator"
