NODE_ENV=development
PORT=5000

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Shared RSA Public Key for JWT Verification
JWT_PUBLIC_KEY_PATH="../../shared/keys/jwt-public.key"

# Downstream Microservices Target URLs
AUTH_SERVICE_URL="http://localhost:5001"
SHIPMENT_SERVICE_URL="http://localhost:5002"
FLEET_SERVICE_URL="http://localhost:5003"
TRACKING_SERVICE_URL="http://localhost:5004"
NOTIFICATION_SERVICE_URL="http://localhost:5005"
