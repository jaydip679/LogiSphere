# LogiSphere — Root Docker Ignore
node_modules
npm-debug.log
.git
.gitignore
docs
coverage
dist

# Environment files in root and all subdirectories
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.log

# Sensitive secrets (Must be mounted or passed via environment, never baked in)
services/auth-service/secrets/jwt-private.key
*private*.key
**/secrets/*
!**/secrets/.gitkeep

# Temporary reports
services/shipment-service/temp_reports
storage/
